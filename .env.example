# Copy this file to ".env" (same folder) and fill in your key.
# .env is listed in .gitignore and must never be shared or committed.

# Required: your Anthropic API key from https://platform.claude.com (Settings > API keys)
ANTHROPIC_API_KEY=

# Model used for extraction (must support image input).
CARDCONV_MODEL=claude-opus-5-5

# Reasoning effort: low | medium | high | xhigh | max. Leave empty for models without effort support.
CARDCONV_EFFORT=high

# On a safety-classifier decline, let the API retry on a recommended fallback model.
CARDCONV_REFUSAL_FALLBACK=true

# Default export mode: review (approve each card) or auto (export clean cards automatically).
CARDCONV_EXPORT_MODE=review

# Longest image edge (pixels) sent to the API. Larger images are downscaled, never upscaled.
CARDCONV_MAX_IMAGE_EDGE=2048

# Attempts per card for transient errors (rate limits, network, server errors). 1-6.
CARDCONV_API_MAX_ATTEMPTS=3
CARDCONV_API_TIMEOUT=120

# Add CHARSET=UTF-8 to non-ASCII vCard lines (helps classic Outlook show accents correctly).
CARDCONV_VCARD_OUTLOOK_CHARSET=true

# Watch folder: seconds a file must stay unchanged before processing; seconds to wait for a *_back file.
CARDCONV_WATCH_STABLE_SECONDS=3
CARDCONV_WATCH_PAIR_WAIT_SECONDS=30

# Storage locations (relative paths are inside the app folder).
CARDCONV_DATA_DIR=data
CARDCONV_EXPORT_DIR=exports
